<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Razers Alliance War Tracker</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #121212;
      color: #e0e0e0;
      margin: 0;
      padding: 8px;
      font-size: 0.82rem;
    }
    .top-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .key-group {
      display: flex;
      gap: 5px;
      align-items: center;
    }
    button {
      padding: 6px 10px;
      border: 1px solid #333;
      border-radius: 5px;
      background: #1e1e1e;
      color: #ccc;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.8rem;
      transition: 0.15s;
    }
    button:hover { background: #2c2c2c; color: #fff; }
    button.active { background: #2e7d32; color: #fff; border-color: #4caf50; }
    button.load-btn { background: #1565c0; color: #fff; border-color: #1976d2; }
    button.load-btn:hover { background: #1976d2; }
    input {
      padding: 6px 8px;
      border-radius: 5px;
      border: 1px solid #333;
      background: #1e1e1e;
      color: #fff;
      width: 155px;
      font-size: 0.8rem;
    }
    .meta {
      font-size: 0.74rem;
      color: #888;
      margin-bottom: 8px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 6px;
    }
    .loc-badge {
      color: #90caf9;
      font-weight: 600;
    }
    .board {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    @media (max-width: 820px) {
      .board { grid-template-columns: 1fr; gap: 10px; }
    }
    .panel {
      background: #181818;
      border-radius: 6px;
      padding: 8px;
      border: 1px solid #2a2a2a;
      overflow-x: auto;
    }
    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #2e2e2e;
      padding-bottom: 6px;
      margin-bottom: 4px;
      gap: 6px;
    }
    h2 {
      margin: 0;
      font-size: 0.95rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .chain-badge {
      font-family: monospace;
      font-size: 0.76rem;
      padding: 2px 7px;
      border-radius: 4px;
      background: #252525;
      color: #aaa;
      border: 1px solid #383838;
      white-space: nowrap;
      font-weight: 600;
    }
    .chain-active {
      background: rgba(46, 125, 50, 0.25);
      color: #81c784;
      border-color: #388e3c;
    }
    .chain-cooldown {
      background: #b3e5fc !important;
      color: #01579b !important;
      border-color: #4fc3f7 !important;
      box-shadow: 0 0 6px rgba(179, 229, 252, 0.45);
    }

    @keyframes flashChainYellow {
      0%, 100% { background-color: rgba(253, 216, 53, 0.35); color: #fff59d; border-color: #fdd835; }
      50% { background-color: rgba(253, 216, 53, 0.08); color: #fdd835; border-color: #827717; }
    }
    @keyframes flashChainRed {
      0%, 100% { background-color: rgba(211, 47, 47, 0.75); color: #ffffff; border-color: #ff5252; }
      50% { background-color: rgba(211, 47, 47, 0.2); color: #ff8a80; border-color: #b71c1c; }
    }
    .chain-warn-yellow {
      animation: flashChainYellow 1.5s infinite;
    }
    .chain-warn-red {
      animation: flashChainRed 0.65s infinite;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
      table-layout: fixed;
    }
    col.col-player { width: 38%; }
    col.col-lvl { width: 9%; }
    col.col-status { width: 23%; }
    col.col-timer { width: 16%; }
    col.col-act { width: 14%; }

    th {
      color: #777;
      font-weight: 600;
      text-align: left;
      padding: 4px 4px;
      border-bottom: 1px solid #2b2b2b;
      white-space: nowrap;
    }
    tbody tr {
      height: 26px;
    }
    tbody tr:nth-child(odd) {
      background-color: #181818;
    }
    tbody tr:nth-child(even) {
      background-color: #202020;
    }
    tbody tr:hover {
      background-color: #292929;
    }
    td {
      padding: 0 4px;
      height: 26px;
      line-height: 26px;
      vertical-align: middle;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .player-cell {
      display: flex;
      align-items: center;
      gap: 5px;
      height: 26px;
    }
    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      flex-shrink: 0;
      display: inline-block;
    }
    .dot-Online { background-color: #4caf50; box-shadow: 0 0 4px rgba(76, 175, 80, 0.7); }
    .dot-Idle { background-color: #ff9800; }
    .dot-Offline { background-color: #555555; }

    a.player-link {
      color: #f0f0f0;
      text-decoration: none;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    a.player-link:hover { text-decoration: underline; color: #90caf9; }

    .la-tag {
      color: #777;
      font-size: 0.7rem;
      flex-shrink: 0;
    }

    .Okay { color: #66bb6a; }
    .Hospital { color: #ef5350; font-weight: 600; }
    .Jail { color: #ffa726; font-weight: 600; }
    .Traveling, .Abroad { color: #42a5f5; }
    .Fallen { color: #757575; font-style: italic; }

    .timer {
      font-family: monospace;
      font-size: 0.8rem;
      padding: 1px 4px;
      border-radius: 3px;
      display: inline-block;
      line-height: 1.2;
    }

    a.atk-btn {
      background: #7f1d1d;
      color: #e0e0e0;
      padding: 2px 6px;
      border-radius: 3px;
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 700;
      display: inline-block;
      line-height: 1.3;
      transition: 0.15s;
    }
    a.atk-btn:hover { background: #b71c1c; color: #fff; }

    @keyframes flashYellow {
      0%, 100% { background-color: rgba(253, 216, 53, 0.28); color: #fff59d; }
      50% { background-color: transparent; color: #fdd835; }
    }
    @keyframes flashRed {
      0%, 100% { background-color: rgba(229, 57, 53, 0.5); color: #ffffff; }
      50% { background-color: transparent; color: #ff5252; }
    }
    @keyframes flashAttackReady {
      0%, 100% { background-color: #2e7d32; color: #ffffff; box-shadow: 0 0 6px rgba(76, 175, 80, 0.85); }
      50% { background-color: #1b5e20; color: #a5d6a7; box-shadow: none; }
    }

    .timer-yellow-solid { background-color: rgba(253, 216, 53, 0.22); color: #fdd835; font-weight: bold; }
    .timer-yellow-slow { animation: flashYellow 1.6s infinite; font-weight: bold; }
    .timer-red-fast { animation: flashRed 0.65s infinite; font-weight: bold; }
    .atk-ready { animation: flashAttackReady 1.5s infinite; }

    @media (max-width: 480px) {
      body { padding: 5px; }
      .panel { padding: 6px; }
      table { font-size: 0.73rem; }
      col.col-player { width: 37%; }
      col.col-lvl { width: 8%; }
      col.col-status { width: 24%; }
      col.col-timer { width: 17%; }
      col.col-act { width: 14%; }
      input { width: 130px; }
    }
  </style>
</head>
<body>

  <div class="top-bar">
    <div class="tabs" id="factionTabs"></div>
    <div class="key-group">
      <input type="password" id="apiKey" placeholder="Public Torn API Key" />
      <button class="load-btn" onclick="fetchWarData()">Load</button>
    </div>
  </div>
  <div class="meta">
    <span id="statusBar">Paste a Public API key in the top right and click Load.</span>
    <span class="loc-badge" id="userLocBadge">Your Location: TC</span>
  </div>

  <div class="board">
    <div class="panel">
      <div class="panel-header">
        <h2 id="allyTitle">Razers</h2>
        <span class="chain-badge" id="allyChain">Chain: -</span>
      </div>
      <table>
        <colgroup>
          <col class="col-player" />
          <col class="col-lvl" />
          <col class="col-status" />
          <col class="col-timer" />
          <col class="col-act" />
        </colgroup>
        <thead>
          <tr><th>Player</th><th>Lvl</th><th>Status</th><th>Timer</th><th>Action</th></tr>
        </thead>
        <tbody id="allyBody"></tbody>
      </table>
    </div>

    <div class="panel">
      <div class="panel-header">
        <h2 id="enemyTitle">Warring Opponent</h2>
        <span class="chain-badge" id="enemyChain">Chain: -</span>
      </div>
      <table>
        <colgroup>
          <col class="col-player" />
          <col class="col-lvl" />
          <col class="col-status" />
          <col class="col-timer" />
          <col class="col-act" />
        </colgroup>
        <thead>
          <tr><th>Player</th><th>Lvl</th><th>Status</th><th>Timer</th><th>Action</th></tr>
        </thead>
        <tbody id="enemyBody"></tbody>
      </table>
    </div>
  </div>

  <script>
    const OUR_FACTIONS = [
      { id: 40449, name: "Razers" },
      { id: 48277, name: "HellRazers" },
      { id: 48628, name: "OccamsRazers" },
      { id: 40385, name: "RazerResistance" }
    ];

    let selectedFactionId = 40449;
    let cachedData = { ally: null, enemy: null };
    let chainState = { ally: null, enemy: null };
    let userLocationCode = "TC";
    let userIsTraveling = false;

    const keyInput = document.getElementById("apiKey");
    keyInput.value = localStorage.getItem("torn_pub_key") || "";
    keyInput.addEventListener("input", () => {
      localStorage.setItem("torn_pub_key", keyInput.value.trim());
      if (keyInput.value.trim().length === 16) fetchWarData();
    });

    const tabContainer = document.getElementById("factionTabs");
    OUR_FACTIONS.forEach(fac => {
      const btn = document.createElement("button");
      btn.textContent = fac.name;
      btn.dataset.id = fac.id;
      btn.onclick = () => {
        selectedFactionId = fac.id;
        updateActiveTab();
        fetchWarData();
      };
      tabContainer.appendChild(btn);
    });

    function updateActiveTab() {
      document.querySelectorAll("#factionTabs button").forEach(b => {
        b.classList.toggle("active", Number(b.dataset.id) === selectedFactionId);
      });
      const current = OUR_FACTIONS.find(f => f.id === selectedFactionId);
      if (current) {
        document.getElementById("allyTitle").textContent = current.name + " [" + current.id + "]";
      }
    }

    async function fetchWithFallback(tornUrl) {
      const urls = [
        tornUrl,
        "https://api.allorigins.win/raw?url=" + encodeURIComponent(tornUrl),
        "https://api.codetabs.com/v1/proxy?quest=" + encodeURIComponent(tornUrl)
      ];
      let lastErr = null;
      for (const u of urls) {
        try {
          const res = await fetch(u);
          if (!res.ok) {
            lastErr = new Error("HTTP " + res.status);
            continue;
          }
          const data = await res.json();
          if (data.error) throw new Error(data.error.error);
          return data;
        } catch (err) {
          lastErr = err;
          if (err.message && !err.message.includes("Failed to fetch") && !err.message.includes("HTTP")) {
            throw err;
          }
        }
      }
      throw lastErr || new Error("Unable to reach Torn API");
    }

    async function getUserLocation(key) {
      try {
        const userUrl = "https://api.torn.com/user/?selections=basic&comment=RazersWarTracker&key=" + encodeURIComponent(key);
        const uData = await fetchWithFallback(userUrl);
        if (uData && uData.status) {
          const parsed = parseStatusInfo(uData.status);
          if (parsed.isTraveling) {
            userIsTraveling = true;
            userLocationCode = "AIR";
            document.getElementById("userLocBadge").textContent = "Your Location: Traveling (" + parsed.label + ")";
          } else {
            userIsTraveling = false;
            userLocationCode = parsed.locCode || "TC";
            document.getElementById("userLocBadge").textContent = "Your Location: " + userLocationCode;
          }
        }
      } catch (e) {
        // Keep previous or default TC if user lookup fails
      }
    }

    async function getFactionCombined(id, key) {
      const v1Url = "https://api.torn.com/faction/" + id + "?selections=basic,chain&comment=RazersWarTracker&key=" + encodeURIComponent(key);
      const v1Data = await fetchWithFallback(v1Url);

      try {
        const v2Url = "https://api.torn.com/v2/faction/" + id + "/members?comment=RazersWarTracker&key=" + encodeURIComponent(key);
        const v2Data = await fetchWithFallback(v2Url);
        if (v2Data && Array.isArray(v2Data.members) && v1Data.members) {
          v2Data.members.forEach(m2 => {
            if (v1Data.members[m2.id] && m2.status) {
              v1Data.members[m2.id].status = m2.status;
            }
          });
        }
      } catch (e) {
        // Keep v1 data if v2 fails
      }

      return v1Data;
    }

    function findOpponentId(factionData, ourId) {
      if (factionData.ranked_wars) {
        for (const war of Object.values(factionData.ranked_wars)) {
          const ids = Object.keys(war.factions).map(Number);
          const opp = ids.find(id => id !== Number(ourId));
          if (opp) return opp;
        }
      }
      if (factionData.territory_wars) {
        for (const war of Object.values(factionData.territory_wars)) {
          const opp = war.assaulting_faction === Number(ourId) ? war.defending_faction : war.assaulting_faction;
          if (opp) return opp;
        }
      }
      if (factionData.raid_wars) {
        for (const war of Object.values(factionData.raid_wars)) {
          const opp = war.raiding_faction === Number(ourId) ? war.defending_faction : war.raiding_faction;
          if (opp) return opp;
        }
      }
      return null;
    }

    function mapCountryCode(rawText) {
      if (!rawText) return "TC";
      const t = rawText.toLowerCase();
      if (t.includes("mexico") || t.includes("mexican")) return "MEX";
      if (t.includes("cayman")) return "CAY";
      if (t.includes("canada") || t.includes("canadian")) return "CAN";
      if (t.includes("hawaii")) return "HAW";
      if (t.includes("united kingdom") || t.includes("british") || t.includes("london") || /uk/.test(t)) return "UK";
      if (t.includes("argentina") || t.includes("argentinian")) return "ARG";
      if (t.includes("switzerland") || t.includes("swiss")) return "SWI";
      if (t.includes("japan") || t.includes("japanese")) return "JAP";
      if (t.includes("china") || t.includes("chinese")) return "CHI";
      if (t.includes("uae") || t.includes("emirates") || t.includes("emirati") || t.includes("dubai")) return "UAE";
      if (t.includes("south africa") || t.includes("african")) return "SA";
      if (t.includes("torn")) return "TC";
      return null;
    }

    function parseStatusInfo(statusObj) {
      const state = statusObj.state || "Okay";
      const desc = statusObj.description || "";
      const details = statusObj.details || "";
      const combined = (desc + " " + details).trim();
      const locCode = mapCountryCode(combined) || "TC";

      if (state === "Fallen") {
        return { label: "Fallen", cssClass: "Fallen", tier: 5, sortKey: "", locCode: "", isTraveling: false };
      }

      if (state === "Hospital" || state === "Jail") {
        const prefix = state === "Hospital" ? "Hosp" : "Jail";
        return {
          label: prefix + " (" + locCode + ")",
          cssClass: state,
          tier: 1,
          sortKey: locCode,
          locCode: locCode,
          isTraveling: false
        };
      }

      if (state === "Traveling") {
        const dLower = combined.toLowerCase();
        let route = "";
        let startLoc = "TC";

        const returnFromMatch = dLower.match(/returning to torn from ([a-z\s]+)/i);
        const fromToMatch = dLower.match(/from ([a-z\s]+) to ([a-z\s]+)/i);
        const toMatch = dLower.match(/(?:traveling|flying) to ([a-z\s]+)/i);

        if (returnFromMatch) {
          const fromCode = mapCountryCode(returnFromMatch[1]) || "ABROAD";
          route = fromCode + " > TC";
          startLoc = fromCode;
        } else if (fromToMatch) {
          const fromCode = mapCountryCode(fromToMatch[1]) || "TC";
          const toCode = mapCountryCode(fromToMatch[2]) || "ABROAD";
          route = fromCode + " > " + toCode;
          startLoc = fromCode;
        } else if (toMatch) {
          const toCode = mapCountryCode(toMatch[1]) || "ABROAD";
          route = "TC > " + toCode;
          startLoc = "TC";
        } else {
          const detected = mapCountryCode(combined);
          if (detected && detected !== "TC") {
            route = dLower.includes("returning") ? (detected + " > TC") : ("TC > " + detected);
            startLoc = dLower.includes("returning") ? detected : "TC";
          } else {
            route = "Traveling";
            startLoc = "ZZZ";
          }
        }

        return {
          label: route,
          cssClass: "Traveling",
          tier: 2,
          sortKey: startLoc,
          locCode: "AIR",
          isTraveling: true
        };
      }

      const abroadCode = mapCountryCode(combined);
      if (state === "Abroad" || (abroadCode && abroadCode !== "TC")) {
        const finalCode = abroadCode || "ABROAD";
        return {
          label: "Okay (" + finalCode + ")",
          cssClass: "Abroad",
          tier: 3,
          sortKey: finalCode,
          locCode: finalCode,
          isTraveling: false
        };
      }

      return {
        label: "Okay (TC)",
        cssClass: "Okay",
        tier: 4,
        sortKey: "TC",
        locCode: "TC",
        isTraveling: false
      };
    }

    function formatShortLastAction(laObj) {
      if (!laObj || !laObj.timestamp) return "";
      const diff = Math.max(0, Math.floor(Date.now() / 1000) - Number(laObj.timestamp));
      if (diff < 60) return diff + "s";
      if (diff < 3600) return Math.floor(diff / 60) + "m";
      if (diff < 86400) return Math.floor(diff / 3600) + "h";
      return Math.floor(diff / 86400) + "d";
    }

    function formatChainTime(sec) {
      if (sec <= 0) return "00:00";
      const m = String(Math.floor(sec / 60)).padStart(2, "0");
      const s = String(sec % 60).padStart(2, "0");
      return m + ":" + s;
    }

    function updateChainDisplay(chainObj, badgeId, isAlly) {
      const badge = document.getElementById(badgeId);
      if (!chainObj || !chainObj.current || chainObj.current === 0) {
        badge.textContent = "Chain: None";
        badge.className = "chain-badge";
        return;
      }

      const now = Math.floor(Date.now() / 1000);
      const current = chainObj.current;
      const max = chainObj.max || "";
      const countStr = max ? (current + "/" + max) : String(current);

      if (chainObj.cooldown && chainObj.cooldown > 0) {
        const cdEnd = chainObj.end ? (chainObj.end + chainObj.cooldown) : (chainObj._fetchedAt + chainObj.cooldown);
        const cdLeft = Math.max(0, cdEnd - now);
        badge.textContent = "Chain: " + current + " (CD " + formatChainTime(cdLeft) + ")";
        badge.className = "chain-badge chain-cooldown";
        return;
      }

      const timeoutEnd = chainObj._timeoutEnd || 0;
      const timeLeft = Math.max(0, timeoutEnd - now);
      badge.textContent = "Chain: " + countStr + " (" + formatChainTime(timeLeft) + ")";

      if (isAlly && timeLeft > 0 && timeLeft < 60) {
        badge.className = "chain-badge chain-warn-red";
      } else if (isAlly && timeLeft > 0 && timeLeft < 150) {
        badge.className = "chain-badge chain-warn-yellow";
      } else if (!isAlly && timeLeft > 0 && timeLeft <= 60) {
        badge.className = "chain-badge chain-warn-red";
      } else {
        badge.className = "chain-badge chain-active";
      }
    }

    async function fetchWarData() {
      const key = keyInput.value.trim();
      if (!key) {
        document.getElementById("statusBar").textContent = "Please paste a Torn Public API key first.";
        return;
      }
      document.getElementById("statusBar").textContent = "Fetching data for Faction " + selectedFactionId + "...";

      try {
        await getUserLocation(key);

        const now = Math.floor(Date.now() / 1000);
        const allyData = await getFactionCombined(selectedFactionId, key);
        cachedData.ally = allyData;
        document.getElementById("allyTitle").textContent = allyData.name + " [" + allyData.ID + "]";

        if (allyData.chain) {
          allyData.chain._fetchedAt = now;
          allyData.chain._timeoutEnd = now + (allyData.chain.timeout || 0);
          chainState.ally = allyData.chain;
        } else {
          chainState.ally = null;
        }
        updateChainDisplay(chainState.ally, "allyChain", true);

        const enemyId = findOpponentId(allyData, selectedFactionId);
        if (enemyId) {
          const enemyData = await getFactionCombined(enemyId, key);
          cachedData.enemy = enemyData;
          document.getElementById("enemyTitle").textContent = enemyData.name + " [" + enemyData.ID + "]";

          if (enemyData.chain) {
            enemyData.chain._fetchedAt = now;
            enemyData.chain._timeoutEnd = now + (enemyData.chain.timeout || 0);
            chainState.enemy = enemyData.chain;
          } else {
            chainState.enemy = null;
          }
          updateChainDisplay(chainState.enemy, "enemyChain", false);
        } else {
          cachedData.enemy = null;
          chainState.enemy = null;
          document.getElementById("enemyTitle").textContent = "No Active War";
          updateChainDisplay(null, "enemyChain", false);
        }

        renderTables();
        document.getElementById("statusBar").textContent = "Showing " + allyData.name + " • Auto-syncing every 15s • Updated: " + new Date().toLocaleTimeString();
      } catch (err) {
        document.getElementById("statusBar").textContent = "Torn API Error: " + err.message;
      }
    }

    function formatCountdown(diffSeconds) {
      if (diffSeconds <= 0) return "00:00:00";
      const h = String(Math.floor(diffSeconds / 3600)).padStart(2, "0");
      const m = String(Math.floor((diffSeconds % 3600) / 60)).padStart(2, "0");
      const s = String(diffSeconds % 60).padStart(2, "0");
      return h + ":" + m + ":" + s;
    }

    function getTimerAlertClass(state, diffSeconds) {
      if (state !== "Hospital" && state !== "Jail") return "";
      if (diffSeconds <= 0) return "timer-red-fast";
      if (diffSeconds <= 120) return "timer-red-fast";
      if (diffSeconds <= 300) return "timer-yellow-slow";
      if (diffSeconds <= 600) return "timer-yellow-solid";
      return "";
    }

    function isSameLocation(targetLocCode, targetIsTraveling) {
      if (userIsTraveling || targetIsTraveling) return false;
      return targetLocCode === userLocationCode;
    }

    function isAttackReady(state, diffSeconds, targetLocCode, targetIsTraveling) {
      if (state === "Fallen") return false;
      if (!isSameLocation(targetLocCode, targetIsTraveling)) return false;
      if (state === "Okay" || state === "Abroad") return true;
      if ((state === "Hospital" || state === "Jail") && diffSeconds <= 20) return true;
      return false;
    }

    function renderRoster(factionData, tbodyId) {
      const tbody = document.getElementById(tbodyId);
      if (!factionData || !factionData.members) {
        tbody.innerHTML = '<tr><td colspan="5" style="color:#777;">No active opponent or data found.</td></tr>';
        return;
      }

      const now = Math.floor(Date.now() / 1000);
      const members = Object.entries(factionData.members).map(([id, m]) => {
        const parsed = parseStatusInfo(m.status);
        const until = m.status.until || 0;
        const diff = until > 0 ? until - now : 0;

        let effectiveState = m.status.state;
        let effectiveParsed = parsed;
        let effectiveUntil = until;

        if ((effectiveState === "Hospital" || effectiveState === "Jail") && until > 0 && diff <= -8) {
          effectiveState = parsed.locCode === "TC" ? "Okay" : "Abroad";
          effectiveUntil = 0;
          effectiveParsed = {
            label: "Okay (" + parsed.locCode + ")",
            cssClass: parsed.locCode === "TC" ? "Okay" : "Abroad",
            tier: parsed.locCode === "TC" ? 4 : 3,
            sortKey: parsed.locCode,
            locCode: parsed.locCode,
            isTraveling: false
          };
        }

        return {
          id,
          ...m,
          effectiveState,
          effectiveUntil,
          parsed: effectiveParsed
        };
      });

      members.sort((a, b) => {
        if (a.parsed.tier !== b.parsed.tier) {
          return a.parsed.tier - b.parsed.tier;
        }
        if (a.parsed.tier === 1) {
          return (a.effectiveUntil || 9999999999) - (b.effectiveUntil || 9999999999);
        }
        if (a.parsed.tier === 2 || a.parsed.tier === 3) {
          const cmp = a.parsed.sortKey.localeCompare(b.parsed.sortKey);
          if (cmp !== 0) return cmp;
        }
        return a.name.localeCompare(b.name);
      });

      tbody.innerHTML = members.map(m => {
        const until = m.effectiveUntil;
        const diff = until > 0 ? until - now : 0;
        const timerText = until > 0 ? formatCountdown(diff) : "-";
        const alertClass = getTimerAlertClass(m.effectiveState, diff);
        const isFallen = m.effectiveState === "Fallen";
        const readyClass = isAttackReady(m.effectiveState, diff, m.parsed.locCode, m.parsed.isTraveling) ? " atk-ready" : "";

        const laState = (m.last_action && m.last_action.status) ? m.last_action.status : "Offline";
        const laShort = formatShortLastAction(m.last_action);

        const atkCell = isFallen
          ? '<td style="color:#666;">-</td>'
          : '<td><a class="atk-btn' + readyClass + '" data-state="' + m.effectiveState + '" data-until="' + until + '" data-loc="' + m.parsed.locCode + '" data-traveling="' + (m.parsed.isTraveling ? "1" : "0") + '" href="https://www.torn.com/page.php?sid=attack&user2ID=' + m.id + '" target="_blank">Attack</a></td>';

        return '<tr>' +
          '<td><div class="player-cell"><span class="dot dot-' + laState + '" title="' + laState + '"></span><a class="player-link" href="https://www.torn.com/profiles.php?XID=' + m.id + '" target="_blank">' + m.name + '</a><span class="la-tag">' + laShort + '</span></div></td>' +
          '<td>' + m.level + '</td>' +
          '<td class="' + m.parsed.cssClass + '">' + m.parsed.label + '</td>' +
          '<td><span class="timer ' + alertClass + '" data-state="' + m.effectiveState + '" data-until="' + until + '">' + timerText + '</span></td>' +
          atkCell +
        '</tr>';
      }).join("");
    }

    function renderTables() {
      renderRoster(cachedData.ally, "allyBody");
      renderRoster(cachedData.enemy, "enemyBody");
    }

    setInterval(() => {
      const now = Math.floor(Date.now() / 1000);
      let needsResort = false;

      document.querySelectorAll(".timer").forEach(el => {
        const until = Number(el.dataset.until);
        const state = el.dataset.state;
        if (until > 0) {
          const diff = until - now;
          el.textContent = formatCountdown(diff);
          el.className = "timer " + getTimerAlertClass(state, diff);
          if ((state === "Hospital" || state === "Jail") && diff <= -8) {
            needsResort = true;
          }
        }
      });

      document.querySelectorAll(".atk-btn").forEach(btn => {
        const until = Number(btn.dataset.until);
        const state = btn.dataset.state;
        const locCode = btn.dataset.loc || "TC";
        const isTraveling = btn.dataset.traveling === "1";
        const diff = until > 0 ? until - now : 0;
        if (isAttackReady(state, diff, locCode, isTraveling)) {
          btn.classList.add("atk-ready");
        } else {
          btn.classList.remove("atk-ready");
        }
      });

      if (needsResort) {
        renderTables();
      }

      if (chainState.ally) updateChainDisplay(chainState.ally, "allyChain", true);
      if (chainState.enemy) updateChainDisplay(chainState.enemy, "enemyChain", false);
    }, 1000);

    setInterval(fetchWarData, 15000);

    updateActiveTab();
    if (keyInput.value) fetchWarData();
  </script>
</body>
</html>
